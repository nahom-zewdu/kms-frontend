# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL, used for OAuth callbacks (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Set either a path to the private key file or the private key itself.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=

# Backend services (defaults to localhost:9090 and localhost:8000)
GO_API_URL=http://localhost:9090
NLP_API_URL=http://localhost:8000

# NODE_ENV is managed by Next.js; do not set it here.
